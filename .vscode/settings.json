{
  "files.associations": {
    "*.tex": "latex"
  },
  "latex-workshop.linting.bibtex.enabled": false,
  "latex-workshop.linting.chktex.enabled": false,
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk",
      "command": "latexmk",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-pdf",
        "%DOC%"
      ]
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk",
      "tools": [
        "latexmk"
      ]
    }
  ]
}
